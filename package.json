{
  "name": "trend-shop-jo",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "python -m http.server 8765 --directory public",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute trend-shop-db --local --file=db/schema.sql",
    "db:seed-local": "wrangler d1 execute trend-shop-db --local --file=db/seed.sql",
    "catalog:curate": "python3 scripts/curate-catalog.py",
    "build:phone": "node scripts/build-contact-phone.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "libphonenumber-js": "1.13.15",
    "wrangler": "^4.0.0"
  }
}
