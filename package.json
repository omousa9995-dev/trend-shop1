{
  "name": "trend-shop-jo",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "python -m http.server 8765 --directory public",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute trend-shop-db --local --file=db/schema.sql",
    "db:seed-local": "wrangler d1 execute trend-shop-db --local --file=db/seed.sql",
    "catalog:curate": "python3 scripts/curate-catalog.py"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
